{
  "manifest_version": 3,
  "name": "QA Data Studio AI",
  "version": "1.0.0",
  "description": "AI-powered test recorder, smart form filler, and locator inspector for QA Data Studio.",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  }
}

